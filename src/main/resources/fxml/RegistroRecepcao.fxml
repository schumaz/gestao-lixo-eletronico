<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="780.0" prefWidth="1060.0" style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.residuos.lixoeletronico.controller.RegistroRecepcaoController">
   <children>
      <!-- HEADER -->
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="12.0"
            style="-fx-border-color: #EAEAEA; -fx-border-width: 0 0 1 0; -fx-padding: 10 50 10 50;">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
               <children>
                  <Label fx:id="lblTituloTela"
                         style="-fx-text-fill: #0B1B4F; -fx-font-size: 22px; -fx-font-weight: bold;"
                         text="Registro de Recepção de Resíduos" />
                  <Label fx:id="lblNomeEmpresaHeader"
                         style="-fx-text-fill: #2E7D32; -fx-font-size: 12px; -fx-font-weight: bold;"
                         text="Empresa autenticada" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="piCarregando" managed="false" prefHeight="24.0" prefWidth="24.0" visible="false" />
            <Button fx:id="btnVoltarPerfil" mnemonicParsing="false" onAction="#handleVoltarPerfil"
                    style="-fx-background-color: #617987; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 16 8 16;"
                    text="Voltar ao Perfil" />
         </children>
      </HBox>

      <!-- CONTEÚDO PRINCIPAL: FORMULÁRIO À ESQUERDA + INVENTÁRIO/BALANÇO À DIREITA -->
      <HBox alignment="TOP_LEFT" spacing="30.0" style="-fx-padding: 22 50 22 50;" VBox.vgrow="ALWAYS">
         <children>
            <!-- FORMULÁRIO DE RECEPÇÃO -->
            <VBox prefWidth="440.0" spacing="11.0"
                  style="-fx-background-color: #F9FAFB; -fx-border-color: #E0E4E8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 18;"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-font-size: 11px;"
                         text="ENTRADA DE LOTE" />
                  <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 18px; -fx-font-weight: bold;"
                         text="Dados da Recepção" />

                  <!-- BUSCA OPCIONAL DE USUÁRIO CADASTRADO -->
                  <VBox spacing="4.0"
                        style="-fx-background-color: #EEF5F0; -fx-border-color: #C8E6C9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">
                     <children>
                        <Label style="-fx-text-fill: #1B5E20; -fx-font-size: 11px; -fx-font-weight: bold;"
                               text="Vincular usuário cadastrado por e-mail (opcional)" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <TextField fx:id="txtBuscarEmailUsuario" promptText="Ex.: usuario@email.com"
                                         style="-fx-background-radius: 6; -fx-border-color: #B0BEC5; -fx-border-radius: 6; -fx-padding: 6;"
                                         HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnBuscarUsuario" mnemonicParsing="false" onAction="#handleBuscarUsuario"
                                      style="-fx-background-color: #1565C0; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 6 12 6 12;"
                                      text="Buscar" />
                              <Button fx:id="btnDesvincularUsuario" managed="false" mnemonicParsing="false"
                                      onAction="#handleDesvincularUsuario"
                                      style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 6 10 6 10;"
                                      text="Desvincular" visible="false" />
                           </children>
                        </HBox>
                        <Label fx:id="lblUsuarioVinculado" managed="false"
                               style="-fx-text-fill: #2E7D32; -fx-font-size: 11px; -fx-font-weight: bold;"
                               visible="false" wrapText="true" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                               text="Nome do usuário / entregador *" />
                        <TextField fx:id="txtNomeUsuario" promptText="Ex.: Mariana Oliveira"
                                   style="-fx-background-radius: 6; -fx-border-color: #CFD8DC; -fx-border-radius: 6; -fx-padding: 7;" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                               text="Contato do usuário *" />
                        <TextField fx:id="txtContatoUsuario" promptText="Ex.: (34) 99123-4567 ou e-mail"
                                   style="-fx-background-radius: 6; -fx-border-color: #CFD8DC; -fx-border-radius: 6; -fx-padding: 7;" />
                     </children>
                  </VBox>

                  <HBox spacing="12.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                                     text="Data de recepção *" />
                              <DatePicker fx:id="dpDataRecepcao" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                                     text="Peso (kg) *" />
                              <TextField fx:id="txtPesoKg" promptText="Ex.: 12.500"
                                         style="-fx-background-radius: 6; -fx-border-color: #CFD8DC; -fx-border-radius: 6; -fx-padding: 7;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="12.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                                     text="Categoria do material *" />
                              <ComboBox fx:id="cbCategoriaMaterial" maxWidth="1.7976931348623157E308"
                                        promptText="Selecione a categoria" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                                     text="Urgência de descarte *" />
                              <ComboBox fx:id="cbUrgenciaDescarte" maxWidth="1.7976931348623157E308"
                                        promptText="Selecione a urgência" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 12px; -fx-font-weight: bold;"
                               text="Tipo / descrição do resíduo *" />
                        <TextField fx:id="txtTipoResiduo" promptText="Ex.: Notebooks corporativos e placas-mãe"
                                   style="-fx-background-radius: 6; -fx-border-color: #CFD8DC; -fx-border-radius: 6; -fx-padding: 7;" />
                     </children>
                  </VBox>

                  <Label fx:id="lblMensagem" minHeight="32.0"
                         style="-fx-font-size: 12px; -fx-font-weight: bold;" wrapText="true" />

                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#handleLimpar"
                                style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 9 16 9 16;"
                                text="Limpar" />
                        <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#handleRegistrarRecepcao"
                                style="-fx-background-color: #2E7D32; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 9 18 9 18;"
                                text="Registrar Recepção" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- PAINEL DE INVENTÁRIO E BALANÇO DE MASSA -->
            <VBox prefWidth="490.0" spacing="12.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox spacing="14.0">
                     <children>
                        <VBox spacing="4.0"
                              style="-fx-background-color: #080D30; -fx-background-radius: 8; -fx-padding: 16;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #64B5F6; -fx-font-size: 11px; -fx-font-weight: bold;"
                                     text="MASSA TOTAL ACUMULADA" />
                              <Label fx:id="lblMassaTotalEmpresa"
                                     style="-fx-text-fill: #FFFFFF; -fx-font-size: 24px; -fx-font-weight: bold;"
                                     text="0 kg" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0"
                              style="-fx-background-color: #E8F5E9; -fx-border-color: #C8E6C9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblTituloMassaEstoque"
                                     style="-fx-text-fill: #2E7D32; -fx-font-size: 11px; -fx-font-weight: bold;"
                                     text="EM ESTOQUE ATUAL" />
                              <Label fx:id="lblMassaEmEstoque"
                                     style="-fx-text-fill: #1B5E20; -fx-font-size: 24px; -fx-font-weight: bold;"
                                     text="0 kg" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #0B1B4F; -fx-font-size: 16px; -fx-font-weight: bold;"
                               text="Inventário de Lotes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAtualizarEstoque" mnemonicParsing="false" onAction="#handleAtualizarEstoque"
                                style="-fx-background-color: #ECEFF1; -fx-text-fill: #0B1B4F; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 12 6 12;"
                                text="Atualizar" />
                     </children>
                  </HBox>

                  <!-- BARRA DE FILTROS DA LISTAGEM (API) -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <ComboBox fx:id="cbFiltroStatus" prefWidth="135.0"
                                  promptText="Todos os status" />
                        <ComboBox fx:id="cbFiltroCategoria" maxWidth="1.7976931348623157E308"
                                  promptText="Todas as categorias" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cbFiltroUrgencia" prefWidth="135.0"
                                  promptText="Todas as urgências" />
                        <Button fx:id="btnFiltrarEstoque" mnemonicParsing="false" onAction="#handleFiltrarEstoque"
                                style="-fx-background-color: #0B1B4F; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 12 7 12;"
                                text="Filtrar" />
                        <Button fx:id="btnLimparFiltros" mnemonicParsing="false" onAction="#handleLimparFiltros"
                                style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 10 7 10;"
                                text="Limpar" />
                     </children>
                  </HBox>

                  <TableView fx:id="tblLotesEstoque" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colData" prefWidth="82.0" text="Data" />
                        <TableColumn fx:id="colMaterial" prefWidth="112.0" text="Material" />
                        <TableColumn fx:id="colTipo" prefWidth="128.0" text="Resíduo" />
                        <TableColumn fx:id="colPeso" prefWidth="68.0" text="Peso (kg)" />
                        <TableColumn fx:id="colUrgencia" prefWidth="72.0" text="Urgência" />
                        <TableColumn fx:id="colStatus" prefWidth="116.0" text="Status" />
                     </columns>
                     <placeholder>
                        <Label style="-fx-text-fill: #78909C;" text="Nenhum lote encontrado para os filtros selecionados." />
                     </placeholder>
                  </TableView>

                  <!-- GESTÃO DE CICLO DE VIDA DO LOTE SELECIONADO -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0"
                        style="-fx-background-color: #F4F6F8; -fx-border-color: #E0E4E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">
                     <children>
                        <Label fx:id="lblLoteSelecionado" maxWidth="1.7976931348623157E308"
                               style="-fx-text-fill: #37474F; -fx-font-size: 12px; -fx-font-weight: bold;"
                               text="Selecione um lote na tabela para atualizar o status." wrapText="true"
                               HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAvancarStatus" disable="true" mnemonicParsing="false"
                                onAction="#handleAvancarStatus"
                                style="-fx-background-color: #1565C0; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 14 7 14;"
                                text="Avançar Status" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
